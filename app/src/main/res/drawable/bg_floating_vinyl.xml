<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- 深邃黑胶质感底色 -->
    <gradient
        android:angle="45"
        android:startColor="#1A1C24"
        android:centerColor="#0F1117"
        android:endColor="#14171F"
        android:type="linear" />
    <!-- 极细高光白微边框 (0.8dp) -->
    <stroke
        android:width="0.8dp"
        android:color="#3DFFFFFF" />
</shape>
